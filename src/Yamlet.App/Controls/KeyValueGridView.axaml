<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Yamlet.App.ViewModels"
             x:Class="Yamlet.App.Controls.KeyValueGridView"
             x:Name="GridRoot"
             x:DataType="vm:EditableRowsViewModel">

  <DockPanel LastChildFill="True">

    <!-- Column header -->
    <Grid DockPanel.Dock="Top" Margin="0,0,0,4" ColumnDefinitions="28,*,*,*,28">
      <TextBlock Grid.Column="1" Classes="heading" Text="KEY" Margin="6,0,0,0" />
      <TextBlock Grid.Column="2" Classes="heading" Text="VALUE" Margin="6,0,0,0" />
      <TextBlock Grid.Column="3" Classes="heading" Text="DESCRIPTION" Margin="6,0,0,0" />
    </Grid>

    <ScrollViewer>
      <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:KeyValueRowViewModel">
            <Grid ColumnDefinitions="28,*,*,*,28" Margin="0,1">
              <CheckBox Grid.Column="0"
                        IsChecked="{Binding Enabled}"
                        IsEnabled="{Binding !IsReadOnly}"
                        VerticalAlignment="Center"
                        Padding="0"
                        Margin="4,0,0,0" />
              <TextBox Grid.Column="1" Text="{Binding Key}" IsReadOnly="{Binding IsReadOnly}" PlaceholderText="key" Margin="2,0" />
              <TextBox Grid.Column="2" Text="{Binding Value}" IsReadOnly="{Binding IsReadOnly}" PlaceholderText="value" Margin="2,0" />
              <TextBox Grid.Column="3" Text="{Binding Description}" IsReadOnly="{Binding IsReadOnly}" PlaceholderText="description" Margin="2,0" />
              <Button Grid.Column="4"
                      Classes="ghost"
                      Padding="4"
                      Command="{Binding #GridRoot.DataContext.RemoveRowCommand}"
                      CommandParameter="{Binding}"
                      IsVisible="{Binding !IsReadOnly}"
                      ToolTip.Tip="Remove row">
                <PathIcon Data="{StaticResource IconClose}" Width="12" Height="12"
                          Foreground="{DynamicResource TextMutedBrush}" />
              </Button>
            </Grid>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

  </DockPanel>

</UserControl>

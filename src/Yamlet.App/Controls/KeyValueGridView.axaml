<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Yamlet.App.ViewModels"
             x:Class="Yamlet.App.Controls.KeyValueGridView"
             x:Name="GridRoot"
             x:DataType="vm:EditableRowsViewModel">

  <UserControl.Styles>
    <Style Selector="Border.kvRow">
      <Setter Property="Background" Value="{DynamicResource InputBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="MinHeight" Value="34" />
    </Style>
    <Style Selector="Border.kvRow:pointerover">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>
    <Style Selector="TextBox.kvCell">
      <Setter Property="Height" Value="32" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="PlaceholderForeground" Value="{DynamicResource TextMutedBrush}" />
    </Style>
    <Style Selector="TextBox.kvCell:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{DynamicResource InputBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>
    <Style Selector="TextBox.kvCell:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{DynamicResource InputBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="ToggleButton.kvEnable">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="ToggleButton.kvEnable:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PanelAltBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="ToggleButton.kvEnable:checked">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="ToggleButton.kvEnable:checked /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="ToggleButton.kvEnable PathIcon">
      <Setter Property="Width" Value="13" />
      <Setter Property="Height" Value="13" />
      <Setter Property="Foreground" Value="Transparent" />
    </Style>
    <Style Selector="ToggleButton.kvEnable:checked PathIcon">
      <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
    </Style>
    <Style Selector="Button.kvRemove">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Opacity" Value="0.65" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Border.kvRow:pointerover Button.kvRemove">
      <Setter Property="Opacity" Value="1" />
    </Style>
    <Style Selector="Button.kvRemove:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource PanelAltBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
  </UserControl.Styles>

  <DockPanel LastChildFill="True">

    <!-- Column header -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="34,1.1*,1.1*,1.4*,34" Margin="0,0,0,4">
      <TextBlock Grid.Column="1" Classes="heading" Text="KEY" Margin="10,0,0,0" />
      <TextBlock Grid.Column="2" Classes="heading" Text="VALUE" Margin="10,0,0,0" />
      <TextBlock Grid.Column="3" Classes="heading" Text="DESCRIPTION" Margin="10,0,0,0" />
    </Grid>

    <ScrollViewer>
      <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:KeyValueRowViewModel">
            <Border Classes="kvRow">
              <Grid ColumnDefinitions="34,1.1*,1.1*,1.4*,34">
                <ToggleButton Grid.Column="0"
                              Classes="kvEnable"
                              IsChecked="{Binding Enabled}"
                              IsEnabled="{Binding !IsReadOnly}"
                              ToolTip.Tip="Enable row">
                  <PathIcon Data="{StaticResource IconCheck}" />
                </ToggleButton>
                <TextBox Grid.Column="1" Classes="kvCell" Text="{Binding Key}" IsReadOnly="{Binding IsReadOnly}" PlaceholderText="key" />
                <TextBox Grid.Column="2" Classes="kvCell" Text="{Binding Value}" IsReadOnly="{Binding IsReadOnly}" PlaceholderText="value" />
                <TextBox Grid.Column="3" Classes="kvCell" Text="{Binding Description}" IsReadOnly="{Binding IsReadOnly}" PlaceholderText="description" />
                <Button Grid.Column="4"
                        Classes="ghost kvRemove"
                        Padding="4"
                        Command="{Binding #GridRoot.DataContext.RemoveRowCommand}"
                        CommandParameter="{Binding}"
                        IsVisible="{Binding !IsReadOnly}"
                        VerticalAlignment="Center"
                        ToolTip.Tip="Remove row">
                  <PathIcon Data="{StaticResource IconClose}" Width="11" Height="11"
                            Foreground="{DynamicResource TextMutedBrush}" />
                </Button>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>

  </DockPanel>

</UserControl>

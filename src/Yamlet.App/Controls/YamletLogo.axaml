<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Yamlet.App.Controls.YamletLogo">

  <!-- Monochrome Yamlet mark: a rounded-square badge with a "Y" lettermark, drawn in
       the accent color. Single-color, transparent interior, scales crisply. -->
  <Viewbox Stretch="Uniform">
    <Canvas Width="64" Height="64">
      <!-- Badge outline -->
      <Rectangle Canvas.Left="11" Canvas.Top="11" Width="42" Height="42"
                 RadiusX="12" RadiusY="12"
                 Stroke="{DynamicResource AccentBrush}" StrokeThickness="3.4"
                 Fill="Transparent" />
      <!-- Y lettermark -->
      <Path Stroke="{DynamicResource AccentBrush}" StrokeThickness="4"
            StrokeLineCap="Round" StrokeJoin="Round"
            Data="M24 25 L32 34 L40 25 M32 34 L32 45" />
    </Canvas>
  </Viewbox>

</UserControl>

<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Yamlet.App.Controls.YamletLogo">

  <!-- The Yamlet mark: an egg with a stylized "Y", drawn on a 64x64 canvas and
       scaled uniformly by the Viewbox. -->
  <Viewbox Stretch="Uniform">
    <Canvas Width="64" Height="64">
      <!-- Egg -->
      <Path Fill="#E8EEF2"
            Data="M32 10 C24 10 18 20 18 31 C18 42 24.5 52 32 52 C39.5 52 46 42 46 31 C46 20 40 10 32 10Z" />
      <!-- Stylized Y -->
      <Path Stroke="#1F2430" StrokeThickness="3"
            StrokeLineCap="Round" StrokeJoin="Round"
            Data="M26.5 24.5L32 30L37.5 24.5M32 30V41" />
    </Canvas>
  </Viewbox>

</UserControl>

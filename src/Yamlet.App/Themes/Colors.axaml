<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Claude-inspired warm dark palette: soft, slightly brown-tinted greys with a
       warm off-white foreground. The accent is green (Yamlet's twist on Claude's clay). -->
  <Color x:Key="RailColor">#FF1B1A18</Color>
  <Color x:Key="SidebarColor">#FF211F1D</Color>
  <Color x:Key="BackgroundColor">#FF262624</Color>
  <Color x:Key="PanelColor">#FF2F2E2B</Color>
  <Color x:Key="PanelAltColor">#FF383631</Color>
  <Color x:Key="BorderColor">#FF3C3A35</Color>
  <Color x:Key="InputColor">#FF211F1D</Color>

  <Color x:Key="TextPrimaryColor">#FFF5F4EF</Color>
  <Color x:Key="TextSecondaryColor">#FFB7B4AA</Color>
  <Color x:Key="TextMutedColor">#FF8A877D</Color>

  <!-- Yamlet accent: a warm green standing in for Claude's clay-orange. -->
  <Color x:Key="AccentColor">#FF4CA877</Color>
  <Color x:Key="AccentHoverColor">#FF5DBA88</Color>
  <Color x:Key="AccentForegroundColor">#FF0C1F16</Color>

  <!-- HTTP method colors: standard mapping, pastel (low-saturation) tones. -->
  <Color x:Key="MethodGetColor">#FF8FD3A8</Color>
  <Color x:Key="MethodPostColor">#FFE6CF8A</Color>
  <Color x:Key="MethodPutColor">#FF9CC0EC</Color>
  <Color x:Key="MethodPatchColor">#FFC3A9E8</Color>
  <Color x:Key="MethodDeleteColor">#FFE8A39C</Color>
  <Color x:Key="MethodOtherColor">#FFB4B2A6</Color>

  <!-- Response status colors: standard mapping, pastel tones. -->
  <Color x:Key="StatusSuccessColor">#FF8FD3A8</Color>
  <Color x:Key="StatusRedirectColor">#FF9CC0EC</Color>
  <Color x:Key="StatusClientErrorColor">#FFE6CF8A</Color>
  <Color x:Key="StatusServerErrorColor">#FFE8A39C</Color>

  <!-- {{variable}} highlighting in editors: amber when the variable resolves in the
       active scopes, red when it's undefined. -->
  <Color x:Key="VariableDefinedColor">#FFE0A458</Color>
  <Color x:Key="VariableUndefinedColor">#FFE2655A</Color>

  <!-- JSON editor syntax colors. Variables intentionally keep their own amber/red
       overlay so placeholders stand apart from normal JSON values. -->
  <Color x:Key="JsonKeyColor">#FF9CC0EC</Color>
  <Color x:Key="JsonValueColor">#FF8FD3A8</Color>

  <!-- Brushes -->
  <SolidColorBrush x:Key="RailBrush" Color="{StaticResource RailColor}" />
  <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource SidebarColor}" />
  <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
  <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
  <SolidColorBrush x:Key="PanelAltBrush" Color="{StaticResource PanelAltColor}" />
  <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
  <SolidColorBrush x:Key="InputBrush" Color="{StaticResource InputColor}" />

  <SolidColorBrush x:Key="TextPrimaryBrush" Color="{StaticResource TextPrimaryColor}" />
  <SolidColorBrush x:Key="TextSecondaryBrush" Color="{StaticResource TextSecondaryColor}" />
  <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}" />

  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
  <SolidColorBrush x:Key="AccentForegroundBrush" Color="{StaticResource AccentForegroundColor}" />

  <!-- Soft accent tint for hover/selection backgrounds (subtle, Claude-like). -->
  <SolidColorBrush x:Key="AccentSoftBrush" Color="#FF4CA877" Opacity="0.18" />
  <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource PanelAltColor}" Opacity="0.6" />

  <SolidColorBrush x:Key="VariableDefinedBrush" Color="{StaticResource VariableDefinedColor}" />
  <SolidColorBrush x:Key="VariableUndefinedBrush" Color="{StaticResource VariableUndefinedColor}" />
  <SolidColorBrush x:Key="JsonKeyBrush" Color="{StaticResource JsonKeyColor}" />
  <SolidColorBrush x:Key="JsonValueBrush" Color="{StaticResource JsonValueColor}" />

</ResourceDictionary>

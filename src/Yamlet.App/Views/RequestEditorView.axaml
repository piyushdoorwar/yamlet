<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Yamlet.App.ViewModels"
             xmlns:controls="using:Yamlet.App.Controls"
             x:Class="Yamlet.App.Views.RequestEditorView"
             x:DataType="vm:RequestEditorViewModel">

  <Grid RowDefinitions="Auto,Auto,*" Margin="14,10,14,12">

    <!-- Title row: type badge + breadcrumb + editable name, Save on the right -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
      <Border Classes="typeBadge" Grid.Column="0">
        <TextBlock Text="HTTP" FontSize="10" FontWeight="Bold"
                   Foreground="{DynamicResource AccentBrush}" />
      </Border>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
        <TextBlock Classes="muted" FontSize="13" VerticalAlignment="Center"
                   Text="{Binding BreadcrumbPrefix}" Margin="0,0,6,0" />
        <TextBox Classes="title" Text="{Binding Name}" PlaceholderText="Request name"
                 VerticalAlignment="Center" MinWidth="120" />
      </StackPanel>
      <Button Grid.Column="2" MinWidth="64" Command="{Binding SaveCommand}" Content="Save" />
    </Grid>

    <!-- Method / URL / Send -->
    <Grid Grid.Row="1" ColumnDefinitions="120,*,Auto" Margin="0,0,0,10">
      <ComboBox Grid.Column="0"
                Margin="0,0,8,0"
                ItemsSource="{x:Static vm:RequestEditorViewModel.Methods}"
                SelectedItem="{Binding SelectedMethod}" />
      <TextBox Grid.Column="1"
               Margin="0,0,8,0"
               PlaceholderText="Enter request URL  (supports {{variables}})"
               Text="{Binding Url}" />
      <Button Grid.Column="2"
              Classes="accent"
              MinWidth="96"
              Command="{Binding SendCommand}"
              IsEnabled="{Binding !IsSending}"
              Content="Send" />
    </Grid>

    <!-- Request + response split. Orientation (stacked vs side-by-side) is set in
         code-behind from the view model's IsSideBySide preference. -->
    <Grid Grid.Row="2" x:Name="SplitArea" RowDefinitions="2*,Auto,1.3*">

    <!-- Request configuration tabs -->
    <Border x:Name="RequestPanel"
            Grid.Row="0"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="10">
      <TabControl>
        <TabItem Header="Params">
          <controls:KeyValueGridView DataContext="{Binding Params}" Margin="0,8,0,0" />
        </TabItem>

        <TabItem>
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="Authorization" VerticalAlignment="Center" />
              <Ellipse Classes="tabdot" IsVisible="{Binding HasAuth}" />
            </StackPanel>
          </TabItem.Header>
          <StackPanel Margin="0,10,0,0" Spacing="10" MaxWidth="520" HorizontalAlignment="Left">
            <ComboBox Width="220"
                      HorizontalAlignment="Left"
                      ItemsSource="{Binding AuthTypes}"
                      SelectedItem="{Binding SelectedAuthType}" />

            <StackPanel Spacing="6" IsVisible="{Binding IsBearerVisible}">
              <TextBlock Classes="heading" Text="TOKEN" />
              <TextBox Text="{Binding BearerToken}" PlaceholderText="Bearer token" />
            </StackPanel>

            <StackPanel Spacing="6" IsVisible="{Binding IsBasicVisible}">
              <TextBlock Classes="heading" Text="USERNAME" />
              <TextBox Text="{Binding BasicUsername}" PlaceholderText="Username" />
              <TextBlock Classes="heading" Text="PASSWORD" />
              <TextBox Text="{Binding BasicPassword}" PasswordChar="•" PlaceholderText="Password" />
            </StackPanel>

            <StackPanel Spacing="6" IsVisible="{Binding IsApiKeyVisible}">
              <TextBlock Classes="heading" Text="KEY" />
              <TextBox Text="{Binding ApiKeyName}" PlaceholderText="Header or param name" />
              <TextBlock Classes="heading" Text="VALUE" />
              <TextBox Text="{Binding ApiKeyValue}" PlaceholderText="Value" />
              <TextBlock Classes="heading" Text="ADD TO" />
              <ComboBox Width="220"
                        HorizontalAlignment="Left"
                        ItemsSource="{Binding ApiKeyLocations}"
                        SelectedItem="{Binding SelectedApiKeyLocation}" />
            </StackPanel>

            <StackPanel Spacing="6" IsVisible="{Binding IsCookieVisible}">
              <TextBlock Classes="heading" Text="COOKIE" />
              <TextBox Text="{Binding Cookie}" PlaceholderText="name=value; other=value" />
            </StackPanel>
          </StackPanel>
        </TabItem>

        <TabItem Header="Headers">
          <controls:KeyValueGridView DataContext="{Binding Headers}" Margin="0,8,0,0" />
        </TabItem>

        <TabItem>
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="Body" VerticalAlignment="Center" />
              <Ellipse Classes="tabdot" IsVisible="{Binding HasBody}" />
            </StackPanel>
          </TabItem.Header>
          <DockPanel Margin="0,10,0,0" LastChildFill="True">
            <ComboBox DockPanel.Dock="Top"
                      Width="220"
                      HorizontalAlignment="Left"
                      Margin="0,0,0,8"
                      ItemsSource="{Binding BodyTypes}"
                      SelectedItem="{Binding SelectedBodyType}" />
            <controls:CodeEditorView Text="{Binding BodyText}"
                                     Language="{Binding BodyEditorLanguage}"
                                     AllowBeautify="{Binding IsJsonBodyEditor}"
                                     IsVisible="{Binding IsBodyEditorVisible}" />
          </DockPanel>
        </TabItem>

        <TabItem Header="Variables">
          <controls:KeyValueGridView DataContext="{Binding Variables}" Margin="0,8,0,0" />
        </TabItem>

        <TabItem>
          <TabItem.Header>
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="Scripts" VerticalAlignment="Center" />
              <Ellipse Classes="tabdot" IsVisible="{Binding HasScripts}" />
            </StackPanel>
          </TabItem.Header>
          <Grid Margin="0,10,0,0" RowDefinitions="*,*" >
            <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,6">
              <TextBlock DockPanel.Dock="Top" Classes="heading" Text="PRE-REQUEST SCRIPT" Margin="0,0,0,4" />
              <controls:CodeEditorView Text="{Binding PreRequestScript}"
                                       Language="javascript" />
            </DockPanel>
            <DockPanel Grid.Row="1" LastChildFill="True" Margin="0,6,0,0">
              <TextBlock DockPanel.Dock="Top" Classes="heading" Text="POST-RESPONSE SCRIPT" Margin="0,0,0,4" />
              <controls:CodeEditorView Text="{Binding PostResponseScript}"
                                       Language="javascript" />
            </DockPanel>
          </Grid>
        </TabItem>

        <TabItem Header="Settings">
          <TextBlock Classes="muted"
                     Margin="0,12,0,0"
                     Text="Per-request settings arrive in a future release." />
        </TabItem>
      </TabControl>
    </Border>

    <!-- Resizable divider between request and response -->
    <GridSplitter x:Name="LayoutSplitter"
                  Grid.Row="1"
                  Height="6"
                  HorizontalAlignment="Stretch"
                  Background="Transparent"
                  ResizeDirection="Rows" />

    <!-- Response panel -->
    <Border x:Name="ResponsePanel"
            Grid.Row="2"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="10">
      <Grid RowDefinitions="Auto,*">

        <!-- Response summary bar -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*">
          <StackPanel Orientation="Horizontal" Spacing="14" IsVisible="{Binding HasResponse}">
            <Border Classes="badge"
                    Background="{Binding ResponseCategory, Converter={x:Static controls:StatusCategoryToBrushConverter.Instance}}">
              <TextBlock Text="{Binding ResponseStatusText}"
                         Foreground="#FF15150F"
                         FontWeight="SemiBold"
                         FontSize="12" />
            </Border>
            <TextBlock VerticalAlignment="Center" Classes="muted" Text="{Binding ResponseDurationText}" />
            <TextBlock VerticalAlignment="Center" Classes="muted" Text="{Binding ResponseSizeText}" />
          </StackPanel>
          <TextBlock Grid.Column="0"
                     Classes="muted"
                     Text="Send the request to see the response."
                     IsVisible="{Binding !HasResponse}" />

          <!-- Toggle between stacked and side-by-side request/response layout. -->
          <Button Grid.Column="1"
                  Classes="ghost"
                  Padding="6"
                  HorizontalAlignment="Right"
                  VerticalAlignment="Center"
                  Command="{Binding ToggleLayoutCommand}"
                  ToolTip.Tip="{Binding LayoutToggleTooltip}">
            <Panel>
              <PathIcon Data="{StaticResource IconLayoutColumns}"
                        Width="16" Height="16"
                        Foreground="{DynamicResource TextMutedBrush}"
                        IsVisible="{Binding !IsSideBySide}" />
              <PathIcon Data="{StaticResource IconLayoutRows}"
                        Width="16" Height="16"
                        Foreground="{DynamicResource TextMutedBrush}"
                        IsVisible="{Binding IsSideBySide}" />
            </Panel>
          </Button>
        </Grid>

        <TabControl Grid.Row="1" Margin="0,6,0,0" IsVisible="{Binding HasResponse}">
          <TabItem Header="Body">
            <controls:CodeEditorView Text="{Binding ResponseBody}"
                                     Language="{Binding ResponseBodyLanguage}"
                                     AllowBeautify="{Binding IsResponseBodyJson}"
                                     IsReadOnly="True" />
          </TabItem>
          <TabItem Header="Headers">
            <controls:CodeEditorView Text="{Binding ResponseHeadersText}"
                                     Language="text"
                                     IsReadOnly="True" />
          </TabItem>
          <TabItem Header="Raw">
            <controls:CodeEditorView Text="{Binding ResponseRaw}"
                                     Language="text"
                                     IsReadOnly="True" />
          </TabItem>
        </TabControl>
      </Grid>
    </Border>

    </Grid>

  </Grid>

</UserControl>

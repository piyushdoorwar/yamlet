<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Yamlet.App.ViewModels"
             xmlns:controls="using:Yamlet.App.Controls"
             x:Name="EditorRoot"
             x:Class="Yamlet.App.Views.RequestEditorView"
             x:DataType="vm:RequestEditorViewModel">

  <UserControl.Styles>
    <Style Selector="Border.formRow">
      <Setter Property="Background" Value="{DynamicResource InputBrush}" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Margin" Value="0,1" />
      <Setter Property="MinHeight" Value="34" />
    </Style>
    <Style Selector="Border.formRow:pointerover">
      <Setter Property="Background" Value="{DynamicResource HoverBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>
    <Style Selector="TextBox.formCell">
      <Setter Property="Height" Value="32" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="FontSize" Value="13" />
      <Setter Property="PlaceholderForeground" Value="{DynamicResource TextMutedBrush}" />
    </Style>
    <Style Selector="TextBox.formCell:pointerover /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{DynamicResource InputBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    </Style>
    <Style Selector="TextBox.formCell:focus /template/ Border#PART_BorderElement">
      <Setter Property="Background" Value="{DynamicResource InputBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="ComboBox.formKind">
      <Setter Property="Height" Value="30" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="9,4" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="BorderBrush" Value="Transparent" />
      <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="ToggleButton.formEnable">
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource TextMutedBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="HorizontalAlignment" Value="Center" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="ToggleButton.formEnable:checked /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="ToggleButton.formEnable PathIcon">
      <Setter Property="Width" Value="13" />
      <Setter Property="Height" Value="13" />
      <Setter Property="Foreground" Value="Transparent" />
    </Style>
    <Style Selector="ToggleButton.formEnable:checked PathIcon">
      <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
    </Style>
    <Style Selector="Button.formBrowse">
      <Setter Property="Height" Value="28" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.formRemove">
      <Setter Property="Width" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Padding" Value="4" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Opacity" Value="0.65" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
    </Style>
    <Style Selector="Border.formRow:pointerover Button.formRemove">
      <Setter Property="Opacity" Value="1" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,*" Margin="10,8,10,10">

    <!-- Title row: type badge + breadcrumb + editable name -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*" Margin="0,0,0,8">
      <Border Classes="typeBadge" Grid.Column="0">
        <TextBlock Text="HTTP" FontSize="10" FontWeight="Bold"
                   Foreground="{DynamicResource AccentBrush}" />
      </Border>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
        <TextBlock Classes="muted" FontSize="12" VerticalAlignment="Center"
                   Text="{Binding BreadcrumbPrefix}" Margin="0,0,6,0" />
        <TextBox Classes="title" Text="{Binding Name}" PlaceholderText="Request name"
                 VerticalAlignment="Center" MinWidth="120" />
      </StackPanel>
    </Grid>

    <!-- Method / URL / Send -->
    <Grid Grid.Row="1" ColumnDefinitions="106,*,Auto" Margin="0,0,0,8">
      <ComboBox Grid.Column="0"
                Margin="0,0,8,0"
                ItemsSource="{x:Static vm:RequestEditorViewModel.Methods}"
                SelectedItem="{Binding SelectedMethod}">
        <ComboBox.SelectionBoxItemTemplate>
          <DataTemplate x:CompileBindings="False">
            <TextBlock Text="{Binding}"
                       FontWeight="SemiBold"
                       Foreground="{Binding Converter={x:Static controls:MethodToBrushConverter.Instance}}" />
          </DataTemplate>
        </ComboBox.SelectionBoxItemTemplate>
        <ComboBox.ItemTemplate>
          <DataTemplate x:CompileBindings="False">
            <TextBlock Text="{Binding}"
                       FontWeight="SemiBold"
                       Foreground="{Binding Converter={x:Static controls:MethodToBrushConverter.Instance}}" />
          </DataTemplate>
        </ComboBox.ItemTemplate>
      </ComboBox>
      <Grid Grid.Column="1" Margin="0,0,8,0">
        <TextBox x:Name="UrlBox"
                 PlaceholderText="Enter request URL  (supports {{variables}})"
                 Text="{Binding Url}"
                 Foreground="Transparent"
                 CaretBrush="{DynamicResource TextPrimaryBrush}"
                 SelectionForegroundBrush="{DynamicResource TextPrimaryBrush}" />
        <TextBlock x:Name="UrlHighlightText"
                   IsHitTestVisible="False"
                   ClipToBounds="True"
                   Padding="10,6"
                   FontSize="13"
                   TextWrapping="NoWrap"
                   TextTrimming="None"
                   Foreground="{DynamicResource TextPrimaryBrush}"
                   VerticalAlignment="Stretch" />
      </Grid>

      <!-- Hover peek for {{variables}} in the URL, resolved against the active environment. -->
      <Popup Grid.Column="1" x:Name="UrlPeekPopup" Placement="Pointer" IsHitTestVisible="False">
        <Border Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="10"
                MaxWidth="340">
          <StackPanel Spacing="4">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <TextBlock Text="{}{{" Foreground="{DynamicResource TextMutedBrush}" />
              <TextBlock x:Name="UrlPeekName" FontWeight="SemiBold" />
              <TextBlock Text="}}" Foreground="{DynamicResource TextMutedBrush}" />
            </StackPanel>
            <TextBlock x:Name="UrlPeekValue" TextWrapping="Wrap"
                       FontFamily="Roboto Mono, Noto Sans Mono, SF Mono, Menlo, Monaco, Consolas, Liberation Mono, DejaVu Sans Mono, monospace"
                       FontSize="12" />
            <TextBlock x:Name="UrlPeekScope" Classes="muted" FontSize="11" />
          </StackPanel>
        </Border>
      </Popup>
      <Button Grid.Column="2"
              Classes="accent"
              MinWidth="58"
              Command="{Binding SendCommand}"
              IsEnabled="{Binding !IsSending}"
              ToolTip.Tip="Send">
        <Viewbox Width="18" Height="18">
          <Path Data="{StaticResource IconSend}"
                Stroke="#FFFFFFFF"
                StrokeThickness="2"
                StrokeLineCap="Round"
                StrokeJoin="Round" />
        </Viewbox>
      </Button>
    </Grid>

    <!-- Request + response split. Orientation (stacked vs side-by-side) is set in
         code-behind from the view model's IsSideBySide preference. -->
    <Grid Grid.Row="2" x:Name="SplitArea" RowDefinitions="*,Auto,*">

    <!-- Request configuration sections -->
    <Border x:Name="RequestPanel"
            Grid.Row="0"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="8">
      <DockPanel LastChildFill="True">
        <Grid DockPanel.Dock="Top"
              ColumnDefinitions="Auto,Auto,*"
              Margin="0,0,0,8">
          <ComboBox Grid.Column="0"
                  Width="160"
                  HorizontalAlignment="Left"
                  ItemsSource="{Binding RequestSections}"
                  SelectedItem="{Binding SelectedRequestSection}" />
          <ComboBox Grid.Column="1"
                    Width="220"
                    HorizontalAlignment="Left"
                    Margin="8,0,0,0"
                    ItemsSource="{Binding BodyTypes}"
                    SelectedItem="{Binding SelectedBodyType}"
                    IsVisible="{Binding IsBodySection}" />
        </Grid>

        <Grid>
          <Panel IsVisible="{Binding IsParamsSection}">
            <controls:KeyValueGridView DataContext="{Binding Params}" />
          </Panel>

          <StackPanel Spacing="8"
                      MaxWidth="520"
                      HorizontalAlignment="Left"
                      IsVisible="{Binding IsAuthorizationSection}">
            <ComboBox Width="220"
                      HorizontalAlignment="Left"
                      ItemsSource="{Binding AuthTypes}"
                      SelectedItem="{Binding SelectedAuthType}" />

            <StackPanel Spacing="6" IsVisible="{Binding IsBearerVisible}">
              <TextBlock Classes="heading" Text="TOKEN" />
              <TextBox Text="{Binding BearerToken}" PlaceholderText="Bearer token" />
            </StackPanel>

            <StackPanel Spacing="6" IsVisible="{Binding IsBasicVisible}">
              <TextBlock Classes="heading" Text="USERNAME" />
              <TextBox Text="{Binding BasicUsername}" PlaceholderText="Username" />
              <TextBlock Classes="heading" Text="PASSWORD" />
              <TextBox Text="{Binding BasicPassword}" PasswordChar="•" PlaceholderText="Password" />
            </StackPanel>

            <StackPanel Spacing="6" IsVisible="{Binding IsApiKeyVisible}">
              <TextBlock Classes="heading" Text="KEY" />
              <TextBox Text="{Binding ApiKeyName}" PlaceholderText="Header or param name" />
              <TextBlock Classes="heading" Text="VALUE" />
              <TextBox Text="{Binding ApiKeyValue}" PlaceholderText="Value" />
              <TextBlock Classes="heading" Text="ADD TO" />
              <ComboBox Width="220"
                        HorizontalAlignment="Left"
                        ItemsSource="{Binding ApiKeyLocations}"
                        SelectedItem="{Binding SelectedApiKeyLocation}" />
            </StackPanel>

            <StackPanel Spacing="6" IsVisible="{Binding IsCookieVisible}">
              <TextBlock Classes="heading" Text="COOKIE" />
              <TextBox Text="{Binding Cookie}" PlaceholderText="name=value; other=value" />
            </StackPanel>
          </StackPanel>

          <Panel IsVisible="{Binding IsHeadersSection}">
            <controls:KeyValueGridView DataContext="{Binding Headers}" />
          </Panel>

          <Grid IsVisible="{Binding IsBodySection}">
            <controls:CodeEditorView
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Stretch"
                                     Text="{Binding BodyText}"
                                     Language="{Binding BodyEditorLanguage}"
                                     AllowBeautify="{Binding IsJsonBodyEditor}"
                                     VariableSource="{Binding}"
                                     IsVisible="{Binding IsBodyEditorVisible}" />
            <Panel HorizontalAlignment="Stretch"
                   VerticalAlignment="Stretch"
                   IsVisible="{Binding IsUrlEncodedBodyVisible}">
              <controls:KeyValueGridView DataContext="{Binding BodyFields}" />
            </Panel>
            <DockPanel LastChildFill="True"
                       HorizontalAlignment="Stretch"
                       VerticalAlignment="Stretch"
                       IsVisible="{Binding IsFormDataBodyVisible}">
              <Grid DockPanel.Dock="Top" ColumnDefinitions="34,1.1*,96,1.2*,1.0*,34" Margin="0,0,0,4">
                <TextBlock Grid.Column="1" Classes="heading" Text="KEY" Margin="10,0,0,0" />
                <TextBlock Grid.Column="2" Classes="heading" Text="TYPE" Margin="10,0,0,0" />
                <TextBlock Grid.Column="3" Classes="heading" Text="VALUE" Margin="10,0,0,0" />
                <TextBlock Grid.Column="4" Classes="heading" Text="DESCRIPTION" Margin="10,0,0,0" />
              </Grid>
              <ScrollViewer>
                <ItemsControl ItemsSource="{Binding BodyFields.Rows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:KeyValueRowViewModel">
                      <Border Classes="formRow">
                        <Grid ColumnDefinitions="34,1.1*,96,1.2*,1.0*,34">
                          <ToggleButton Grid.Column="0"
                                        Classes="formEnable"
                                        IsChecked="{Binding Enabled}"
                                        IsEnabled="{Binding !IsReadOnly}"
                                        ToolTip.Tip="Enable row">
                            <PathIcon Data="{StaticResource IconCheck}" />
                          </ToggleButton>
                          <TextBox Grid.Column="1"
                                   Classes="formCell"
                                   Text="{Binding Key}"
                                   IsReadOnly="{Binding IsReadOnly}"
                                   PlaceholderText="key" />
                          <ComboBox Grid.Column="2"
                                    Classes="formKind"
                                    ItemsSource="{x:Static vm:KeyValueRowViewModel.FormDataValueTypes}"
                                    SelectedItem="{Binding FormDataValueType}"
                                    IsEnabled="{Binding !IsReadOnly}" />
                          <Grid Grid.Column="3" ColumnDefinitions="*,Auto">
                            <TextBox Grid.Column="0"
                                     Classes="formCell"
                                     Text="{Binding Value}"
                                     IsReadOnly="{Binding IsReadOnly}"
                                     PlaceholderText="{Binding ValuePlaceholder}" />
                            <Button Grid.Column="1"
                                    Classes="formBrowse"
                                    Margin="6,2,2,2"
                                    Command="{Binding #EditorRoot.DataContext.SelectBodyFileCommand}"
                                    CommandParameter="{Binding}"
                                    IsVisible="{Binding IsFileValue}"
                                    IsEnabled="{Binding !IsReadOnly}"
                                    Content="Browse" />
                          </Grid>
                          <TextBox Grid.Column="4"
                                   Classes="formCell"
                                   Text="{Binding Description}"
                                   IsReadOnly="{Binding IsReadOnly}"
                                   PlaceholderText="description" />
                          <Button Grid.Column="5"
                                  Classes="ghost formRemove"
                                  Command="{Binding #EditorRoot.DataContext.BodyFields.RemoveRowCommand}"
                                  CommandParameter="{Binding}"
                                  IsVisible="{Binding !IsReadOnly}"
                                  VerticalAlignment="Center"
                                  ToolTip.Tip="Remove row">
                            <PathIcon Data="{StaticResource IconClose}" Width="11" Height="11"
                                      Foreground="{DynamicResource TextMutedBrush}" />
                          </Button>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </ScrollViewer>
            </DockPanel>
          </Grid>

          <Panel IsVisible="{Binding IsVariablesSection}">
            <controls:KeyValueGridView DataContext="{Binding Variables}" />
          </Panel>

          <DockPanel LastChildFill="True" IsVisible="{Binding IsCodeSection}">
            <Button DockPanel.Dock="Top"
                    HorizontalAlignment="Right"
                    Margin="0,0,0,8"
                    Command="{Binding RefreshCodeSnippetCommand}"
                    Content="Refresh" />
            <controls:CodeEditorView Text="{Binding CodeSnippet}"
                                     HorizontalAlignment="Stretch"
                                     VerticalAlignment="Stretch"
                                     Language="bash"
                                     IsReadOnly="True" />
          </DockPanel>

          <ListBox ItemsSource="{Binding RequestHistory}"
                   IsVisible="{Binding IsHistorySection}">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}" FontFamily="Roboto Mono, Noto Sans Mono, SF Mono, Menlo, Monaco, Consolas, Liberation Mono, DejaVu Sans Mono, monospace" />
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>

          <Grid RowDefinitions="*,*" IsVisible="{Binding IsScriptsSection}">
            <DockPanel Grid.Row="0" LastChildFill="True" Margin="0,0,0,6">
              <TextBlock DockPanel.Dock="Top" Classes="heading" Text="PRE-REQUEST SCRIPT" Margin="0,0,0,4" />
              <controls:CodeEditorView Text="{Binding PreRequestScript}"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch"
                                       Language="javascript" />
            </DockPanel>
            <DockPanel Grid.Row="1" LastChildFill="True" Margin="0,6,0,0">
              <TextBlock DockPanel.Dock="Top" Classes="heading" Text="POST-RESPONSE SCRIPT" Margin="0,0,0,4" />
              <controls:CodeEditorView Text="{Binding PostResponseScript}"
                                       HorizontalAlignment="Stretch"
                                       VerticalAlignment="Stretch"
                                       Language="javascript" />
            </DockPanel>
          </Grid>

          <TextBlock Classes="muted"
                     Text="Per-request settings arrive in a future release."
                     IsVisible="{Binding IsSettingsSection}" />
        </Grid>
      </DockPanel>
    </Border>

    <!-- Resizable divider between request and response -->
    <GridSplitter x:Name="LayoutSplitter"
                  Grid.Row="1"
                  Height="6"
                  HorizontalAlignment="Stretch"
                  Background="Transparent"
                  ResizeDirection="Rows" />

    <!-- Response panel -->
    <Border x:Name="ResponsePanel"
            Grid.Row="2"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="6"
            Padding="8">
      <Grid RowDefinitions="Auto,*">

        <!-- Condensed response bar: view dropdown on the left, status/time/size on the right. -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto">
          <ComboBox Grid.Column="0"
                    MinWidth="110"
                    ItemsSource="{Binding ResponseViews}"
                    SelectedItem="{Binding SelectedResponseView}"
                    IsVisible="{Binding HasResponse}" />
          <TextBlock Grid.Column="0"
                     Classes="muted"
                     VerticalAlignment="Center"
                     Text="Send the request to see the response."
                     IsVisible="{Binding !HasResponse}" />

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12"
                      VerticalAlignment="Center" IsVisible="{Binding HasResponse}">
            <Border Classes="badge" VerticalAlignment="Center"
                    Background="{Binding ResponseCategory, Converter={x:Static controls:StatusCategoryToBrushConverter.Instance}}">
              <TextBlock Text="{Binding ResponseStatusText}"
                         Foreground="#FF15150F"
                         FontWeight="SemiBold"
                         FontSize="12" />
            </Border>
            <TextBlock VerticalAlignment="Center" Classes="muted" Text="{Binding ResponseDurationText}" />
            <TextBlock VerticalAlignment="Center" Classes="muted" Text="{Binding ResponseSizeText}" />
          </StackPanel>
          <Button Grid.Column="3"
                  Classes="ghost"
                  Padding="6"
                  Margin="10,0,0,0"
                  VerticalAlignment="Center"
                  Click="OnCopyResponseClicked"
                  ToolTip.Tip="Copy response"
                  IsVisible="{Binding HasResponse}">
            <PathIcon Data="{StaticResource IconCopy}" Width="14" Height="14" />
          </Button>
        </Grid>

        <Panel Grid.Row="1" Margin="0,8,0,0" IsVisible="{Binding HasResponse}">
          <controls:CodeEditorView Text="{Binding ResponseBody}"
                                   Language="{Binding ResponseBodyLanguage}"
                                   IsReadOnly="True"
                                   IsVisible="{Binding IsResponseBodyView}" />
          <controls:CodeEditorView Text="{Binding ResponseHeadersText}"
                                   Language="text"
                                   IsReadOnly="True"
                                   IsVisible="{Binding IsResponseHeadersView}" />
          <controls:CodeEditorView Text="{Binding ResponseRaw}"
                                   Language="text"
                                   IsReadOnly="True"
                                   IsVisible="{Binding IsResponseRawView}" />
          <controls:CodeEditorView Text="{Binding ResponseConsole}"
                                   Language="text"
                                   IsReadOnly="True"
                                   IsVisible="{Binding IsResponseConsoleView}" />
        </Panel>
      </Grid>
    </Border>

    </Grid>

  </Grid>

</UserControl>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Yamlet.App.ViewModels"
        xmlns:views="using:Yamlet.App.Views"
        xmlns:controls="using:Yamlet.App.Controls"
        xmlns:models="using:Yamlet.App.Models"
        x:Class="Yamlet.App.Views.MainWindow"
        x:Name="RootWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Yamlet"
        Width="1280" Height="820"
        MinWidth="900" MinHeight="560">

  <Window.DataTemplates>
    <!-- Main-panel editors, selected by view-model type. -->
    <DataTemplate DataType="vm:RequestEditorViewModel">
      <views:RequestEditorView />
    </DataTemplate>
    <DataTemplate DataType="vm:VariableSetEditorViewModel">
      <views:VariableSetEditorView />
    </DataTemplate>
    <DataTemplate DataType="vm:CollectionSettingsViewModel">
      <views:CollectionSettingsView />
    </DataTemplate>
    <DataTemplate DataType="vm:RunnerViewModel">
      <views:RunnerView />
    </DataTemplate>

    <!-- Tree node templates, selected by node type. -->
    <TreeDataTemplate DataType="vm:CollectionNodeViewModel" ItemsSource="{Binding Children}">
      <Grid Classes="treeNodeRow" ColumnDefinitions="Auto,*,Auto" Background="Transparent" HorizontalAlignment="Stretch">
        <PathIcon Grid.Column="0" Data="{StaticResource IconCollections}" Width="15" Height="15"
                  Margin="0,0,6,0" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
        <Button Grid.Column="2" Classes="ghost nodeMenu" Margin="8,0,12,0"
                VerticalAlignment="Center" ToolTip.Tip="Collection actions">
          <PathIcon Data="{StaticResource IconMoreHorizontal}" Width="14" Height="14"
                    Foreground="{DynamicResource TextMutedBrush}" />
          <Button.Flyout>
            <MenuFlyout>
              <MenuItem Header="Rename"
                        Command="{Binding #RootWindow.DataContext.RenameNodeCommand}"
                        CommandParameter="{Binding}" />
              <MenuItem Header="Add Folder"
                        Command="{Binding #RootWindow.DataContext.NewFolderForNodeCommand}"
                        CommandParameter="{Binding}" />
              <MenuItem Header="Add Request"
                        Command="{Binding #RootWindow.DataContext.NewRequestForNodeCommand}"
                        CommandParameter="{Binding}" />
              <MenuItem Header="Run Collection"
                        Command="{Binding #RootWindow.DataContext.RunNodeCommand}"
                        CommandParameter="{Binding}" />
              <MenuItem Header="Delete Collection"
                        Command="{Binding #RootWindow.DataContext.DeleteNodeCommand}"
                        CommandParameter="{Binding}" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
      </Grid>
    </TreeDataTemplate>

    <TreeDataTemplate DataType="vm:FolderNodeViewModel" ItemsSource="{Binding Children}">
      <Grid Classes="treeNodeRow" ColumnDefinitions="Auto,*,Auto" Background="Transparent" HorizontalAlignment="Stretch">
        <PathIcon Grid.Column="0" Data="{StaticResource IconFolder}" Width="15" Height="15"
                  Margin="0,0,6,0" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
        <Button Grid.Column="2" Classes="ghost nodeMenu" Margin="8,0,12,0"
                VerticalAlignment="Center" ToolTip.Tip="Folder actions">
          <PathIcon Data="{StaticResource IconMoreHorizontal}" Width="14" Height="14"
                    Foreground="{DynamicResource TextMutedBrush}" />
          <Button.Flyout>
            <MenuFlyout>
              <MenuItem Header="Rename"
                        Command="{Binding #RootWindow.DataContext.RenameNodeCommand}"
                        CommandParameter="{Binding}" />
              <MenuItem Header="Add Request"
                        Command="{Binding #RootWindow.DataContext.NewRequestForNodeCommand}"
                        CommandParameter="{Binding}" />
              <MenuItem Header="Run Folder"
                        Command="{Binding #RootWindow.DataContext.RunNodeCommand}"
                        CommandParameter="{Binding}" />
              <MenuItem Header="Delete Folder"
                        Command="{Binding #RootWindow.DataContext.DeleteNodeCommand}"
                        CommandParameter="{Binding}" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
      </Grid>
    </TreeDataTemplate>

    <DataTemplate DataType="vm:RequestNodeViewModel">
      <Grid Classes="treeNodeRow" ColumnDefinitions="Auto,*,Auto" Background="Transparent" HorizontalAlignment="Stretch">
        <TextBlock Grid.Column="0" Text="{Binding MethodLabel}"
                   Classes="methodVerb"
                   Foreground="{Binding Method, Converter={x:Static controls:MethodToBrushConverter.Instance}}"
                   Margin="0,0,8,0" VerticalAlignment="Center" />
        <TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center"
                   TextTrimming="CharacterEllipsis" />
        <Button Grid.Column="2" Classes="ghost nodeMenu" Margin="8,0,12,0"
                VerticalAlignment="Center" ToolTip.Tip="Request actions">
          <PathIcon Data="{StaticResource IconMoreHorizontal}" Width="14" Height="14"
                    Foreground="{DynamicResource TextMutedBrush}" />
          <Button.Flyout>
            <MenuFlyout>
              <MenuItem Header="Rename"
                        Command="{Binding #RootWindow.DataContext.RenameNodeCommand}"
                        CommandParameter="{Binding}" />
              <MenuItem Header="Duplicate"
                        Command="{Binding #RootWindow.DataContext.DuplicateRequestCommand}"
                        CommandParameter="{Binding}" />
              <MenuItem Header="Delete Request"
                        Command="{Binding #RootWindow.DataContext.DeleteRequestCommand}"
                        CommandParameter="{Binding}" />
            </MenuFlyout>
          </Button.Flyout>
        </Button>
      </Grid>
    </DataTemplate>
  </Window.DataTemplates>

  <Grid RowDefinitions="*,Auto">

    <Grid Grid.Row="0" ColumnDefinitions="320,Auto,*">

      <!-- Left sidebar -->
      <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
              BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">

          <!-- Workspace bar -->
          <Grid Grid.Row="0" Margin="12,12,12,10" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
            <controls:YamletLogo Grid.Row="0" Grid.RowSpan="2" Width="48" Height="48"
                                 VerticalAlignment="Center" Margin="0,0,10,0" />
            <Grid Grid.Row="0" Grid.Column="1" ColumnDefinitions="*,Auto" VerticalAlignment="Center">
              <TextBlock Grid.Column="0" Text="{Binding WorkspaceHeaderTitle}"
                         FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
              <Button Grid.Column="1" Classes="ghost" Padding="4" Click="OnAboutClick"
                      VerticalAlignment="Center" ToolTip.Tip="About Yamlet">
                <PathIcon Data="{StaticResource IconInfo}" Width="16" Height="16"
                          Foreground="{DynamicResource TextMutedBrush}" />
              </Button>
            </Grid>
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
              <Button Padding="10,4" Command="{Binding OpenWorkspaceCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource IconFolderOpen}" Width="14" Height="14" />
                  <TextBlock Text="Open" />
                </StackPanel>
              </Button>
              <Button Classes="accent" Padding="10,4" Command="{Binding NewWorkspaceCommand}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <PathIcon Data="{StaticResource IconPlus}" Width="14" Height="14" />
                  <TextBlock Text="New" />
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>

          <!-- COLLECTIONS section header -->
          <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="6,2,8,0">
            <Button Classes="section" Command="{Binding ToggleCollectionsCommand}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <PathIcon Width="12" Height="12" Foreground="{DynamicResource TextMutedBrush}"
                          Data="{Binding CollectionsExpanded, Converter={x:Static controls:ChevronConverter.Instance}}" />
                <TextBlock Classes="heading" Text="COLLECTIONS" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
              <Button Classes="ghost" Padding="4" Command="{Binding CollapseCollectionsCommand}" ToolTip.Tip="Collapse all">
                <PathIcon Data="{StaticResource IconCollapseAll}" Width="13" Height="13" />
              </Button>
              <Button Classes="ghost" Padding="4" Command="{Binding NewCollectionCommand}" ToolTip.Tip="New collection">
                <PathIcon Data="{StaticResource IconPlus}" Width="13" Height="13" />
              </Button>
            </StackPanel>
          </Grid>

          <!-- COLLECTIONS content -->
          <Panel Grid.Row="2" Margin="6,2,6,6" IsVisible="{Binding CollectionsExpanded}">
            <TextBlock Classes="muted" Margin="10,6" TextWrapping="Wrap" FontSize="12"
                       IsVisible="{Binding ShowNoWorkspaceMessage}"
                       Text="No workspace open. Use New to create a Yamlet workspace, or Open to load an existing one." />
            <StackPanel Margin="10,6" Spacing="8"
                        IsVisible="{Binding IsRestoringCachedWorkspace}">
              <TextBlock Classes="muted" FontSize="12"
                         Text="Loading workspace..." />
              <ProgressBar Width="150" Height="3" HorizontalAlignment="Left"
                           IsIndeterminate="True" />
            </StackPanel>
            <TreeView ItemsSource="{Binding CollectionNodes}"
                      x:Name="CollectionsTree"
                      SelectedItem="{Binding SelectedNode}"
                      IsVisible="{Binding ShowCollectionsTree}"
                      Background="Transparent"
                      DragDrop.AllowDrop="True"
                      ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                      x:CompileBindings="False">
              <TreeView.Styles>
                <Style Selector="TreeViewItem">
                  <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                </Style>
                <!-- Green hover on the row header (full width, doesn't highlight ancestors). -->
                <Style Selector="TreeViewItem /template/ Border#PART_Header:pointerover">
                  <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                </Style>
              </TreeView.Styles>
            </TreeView>
          </Panel>

          <!-- ENVIRONMENTS section header -->
          <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="6,0,8,0"
                Background="{StaticResource SidebarBrush}">
            <Button Classes="section" Command="{Binding ToggleEnvironmentsCommand}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <PathIcon Width="12" Height="12" Foreground="{DynamicResource TextMutedBrush}"
                          Data="{Binding EnvironmentsExpanded, Converter={x:Static controls:ChevronConverter.Instance}}" />
                <TextBlock Classes="heading" Text="ENVIRONMENTS" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </Grid>

          <!-- ENVIRONMENTS content -->
          <Border Grid.Row="4" Margin="6,2,6,8" MaxHeight="220"
                  IsVisible="{Binding EnvironmentsExpanded}">
            <Panel>
              <TextBlock Classes="muted" Margin="10,6" FontSize="12"
                         IsVisible="{Binding !HasWorkspace}"
                         Text="Environments appear here once a workspace is open." />
              <ListBox ItemsSource="{Binding Environments}"
                       SelectedItem="{Binding SelectedEnvironment}"
                       IsVisible="{Binding HasWorkspace}"
                       Background="Transparent">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="models:YamletEnvironment">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <PathIcon Data="{StaticResource IconEnvironment}" Width="14" Height="14"
                                Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Panel>
          </Border>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1" Width="1" Background="{StaticResource BorderBrush}"
                    ResizeDirection="Columns" />

      <!-- Main work area: open tabs + active editor -->
      <Grid Grid.Column="2" Background="{StaticResource BackgroundBrush}" RowDefinitions="Auto,*">

        <!-- Tab strip -->
        <Border Grid.Row="0" Background="{StaticResource RailBrush}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1"
                IsVisible="{Binding HasOpenTabs}">
          <Grid ColumnDefinitions="Auto,*">
            <ComboBox Grid.Column="0"
                      Classes="tabPicker"
                      Width="42"
                      MinHeight="0"
                      Padding="8,7"
                      ItemsSource="{Binding OverflowTabs}"
                      SelectedItem="{Binding SelectedOverflowTab, Mode=TwoWay}"
                      IsVisible="{Binding HasOverflowTabs}"
                      ToolTip.Tip="Open tabs">
              <ComboBox.SelectionBoxItemTemplate>
                <DataTemplate>
                  <PathIcon Data="{StaticResource IconChevronDown}" Width="13" Height="13"
                            Foreground="{DynamicResource TextSecondaryBrush}" />
                </DataTemplate>
              </ComboBox.SelectionBoxItemTemplate>
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:OpenTabViewModel">
                  <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                    <TextBlock Text="{Binding MethodLabel}"
                               Classes="methodVerb tabMethod"
                               Foreground="{Binding Method, Converter={x:Static controls:MethodToBrushConverter.Instance}}"
                               VerticalAlignment="Center"
                               IsVisible="{Binding IsRequest}" />
                    <PathIcon Data="{StaticResource IconEnvironment}" Width="13" Height="13"
                              Foreground="{DynamicResource TextSecondaryBrush}"
                              VerticalAlignment="Center" IsVisible="{Binding IsEnvironment}" />
                    <PathIcon Data="{StaticResource IconCollections}" Width="13" Height="13"
                              Foreground="{DynamicResource TextSecondaryBrush}"
                              VerticalAlignment="Center" IsVisible="{Binding IsCollection}" />
                    <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>

            <ItemsControl Grid.Column="1" ItemsSource="{Binding VisibleTabs}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <UniformGrid Rows="1" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:OpenTabViewModel">
                  <Border Classes="tab" Classes.active="{Binding IsActive}">
                    <Grid ColumnDefinitions="*,Auto,Auto">
                      <Button Grid.Column="0" Classes="tabbody" Command="{Binding ActivateCommand}">
                        <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                          <TextBlock Text="{Binding MethodLabel}"
                                     Classes="methodVerb tabMethod"
                                     Foreground="{Binding Method, Converter={x:Static controls:MethodToBrushConverter.Instance}}"
                                     VerticalAlignment="Center"
                                     IsVisible="{Binding IsRequest}" />
                          <PathIcon Data="{StaticResource IconEnvironment}" Width="13" Height="13"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    VerticalAlignment="Center" IsVisible="{Binding IsEnvironment}" />
                          <PathIcon Data="{StaticResource IconCollections}" Width="13" Height="13"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    VerticalAlignment="Center" IsVisible="{Binding IsCollection}" />
                          <PathIcon Data="{StaticResource IconRunner}" Width="13" Height="13"
                                    Foreground="{DynamicResource TextSecondaryBrush}"
                                    VerticalAlignment="Center" IsVisible="{Binding IsRunner}" />
                          <TextBlock Text="{Binding Title}" VerticalAlignment="Center"
                                     TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </Button>
                      <Button Grid.Column="1" Classes="ghost tabMenu" Padding="4" Margin="0"
                              VerticalAlignment="Center" ToolTip.Tip="Tab options">
                        <PathIcon Data="{StaticResource IconChevronDown}" Width="10" Height="10"
                                  Foreground="{DynamicResource TextMutedBrush}" />
                        <Button.Flyout>
                          <MenuFlyout>
                            <MenuItem Header="Close Other Tabs" Command="{Binding CloseOthersCommand}" />
                            <MenuItem Header="Close All Tabs" Command="{Binding CloseAllCommand}" />
                          </MenuFlyout>
                        </Button.Flyout>
                      </Button>
                      <Button Grid.Column="2" Classes="ghost" Padding="4" Margin="0,0,6,0"
                              VerticalAlignment="Center" Command="{Binding CloseCommand}" ToolTip.Tip="Close">
                        <PathIcon Data="{StaticResource IconClose}" Width="10" Height="10"
                                  Foreground="{DynamicResource TextMutedBrush}" />
                      </Button>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

          </Grid>
        </Border>

        <!-- Active tab content / empty state -->
        <Panel Grid.Row="1">
          <ContentControl Content="{Binding SelectedTab.Content}" IsVisible="{Binding HasOpenTabs}" />
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10"
                      IsVisible="{Binding IsRestoringCachedWorkspace}">
            <controls:YamletLogo Width="56" Height="56" HorizontalAlignment="Center" />
            <TextBlock Classes="muted" HorizontalAlignment="Center"
                       Text="Loading workspace..." />
            <ProgressBar Width="180" Height="3" IsIndeterminate="True" />
          </StackPanel>
          <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10"
                      IsVisible="{Binding ShowMainEmptyState}">
            <controls:YamletLogo Width="56" Height="56" HorizontalAlignment="Center" />
            <TextBlock Classes="muted" HorizontalAlignment="Center"
                       Text="Select a collection or request to get started." />
          </StackPanel>
        </Panel>
      </Grid>
    </Grid>

    <!-- Status bar -->
    <Border Grid.Row="1" Background="{StaticResource RailBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
            Padding="12,5">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Grid.Column="0" FontSize="12" Classes="muted"
                   VerticalAlignment="Center" Text="{Binding StatusMessage}" />
        <ComboBox Grid.Column="1"
                  Classes="statusEnvPicker"
                  MinHeight="0"
                  Padding="8,3"
                  MaxWidth="220"
                  PlaceholderText="No environment"
                  ItemsSource="{Binding Environments}"
                  SelectedItem="{Binding SelectedEnvironmentPicker, Mode=TwoWay}"
                  ToolTip.Tip="Active environment for variable resolution">
          <ComboBox.SelectionBoxItemTemplate>
            <DataTemplate x:DataType="models:YamletEnvironment">
              <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
            </DataTemplate>
          </ComboBox.SelectionBoxItemTemplate>
          <ComboBox.ItemTemplate>
            <DataTemplate x:DataType="models:YamletEnvironment">
              <StackPanel Orientation="Horizontal" Spacing="7">
                <PathIcon Data="{StaticResource IconEnvironment}" Width="13" Height="13"
                          Foreground="{DynamicResource TextSecondaryBrush}"
                          VerticalAlignment="Center" />
                <TextBlock Text="{Binding Name}" FontSize="12" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />
              </StackPanel>
            </DataTemplate>
          </ComboBox.ItemTemplate>
        </ComboBox>

        <!-- Stacked vs side-by-side request/response layout toggle (active editor only). -->
        <Button Grid.Column="2"
                Classes="ghost"
                Padding="5"
                Margin="10,0,0,0"
                VerticalAlignment="Center"
                IsVisible="{Binding CurrentEditor, Converter={x:Static ObjectConverters.IsNotNull}}"
                Command="{Binding CurrentEditor.ToggleLayoutCommand}"
                ToolTip.Tip="{Binding CurrentEditor.LayoutToggleTooltip}">
          <Panel>
            <PathIcon Data="{StaticResource IconLayoutColumns}"
                      Width="15" Height="15"
                      Foreground="{DynamicResource TextMutedBrush}"
                      IsVisible="{Binding !CurrentEditor.IsSideBySide}" />
            <PathIcon Data="{StaticResource IconLayoutRows}"
                      Width="15" Height="15"
                      Foreground="{DynamicResource TextMutedBrush}"
                      IsVisible="{Binding CurrentEditor.IsSideBySide}" />
          </Panel>
        </Button>
      </Grid>
    </Border>
  </Grid>

</Window>

<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Yamlet.App.ViewModels"
        xmlns:views="using:Yamlet.App.Views"
        xmlns:controls="using:Yamlet.App.Controls"
        xmlns:models="using:Yamlet.App.Models"
        x:Class="Yamlet.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Yamlet"
        Width="1280" Height="820"
        MinWidth="900" MinHeight="560">

  <Window.DataTemplates>
    <!-- Main-panel editors, selected by view-model type. -->
    <DataTemplate DataType="vm:RequestEditorViewModel">
      <views:RequestEditorView />
    </DataTemplate>
    <DataTemplate DataType="vm:VariableSetEditorViewModel">
      <views:VariableSetEditorView />
    </DataTemplate>

    <!-- Tree node templates, selected by node type. -->
    <TreeDataTemplate DataType="vm:CollectionNodeViewModel" ItemsSource="{Binding Children}">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <PathIcon Data="{StaticResource IconCollections}" Width="15" Height="15"
                  Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
      </StackPanel>
    </TreeDataTemplate>

    <TreeDataTemplate DataType="vm:FolderNodeViewModel" ItemsSource="{Binding Children}">
      <StackPanel Orientation="Horizontal" Spacing="6">
        <PathIcon Data="{StaticResource IconFolder}" Width="15" Height="15"
                  Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
      </StackPanel>
    </TreeDataTemplate>

    <DataTemplate DataType="vm:RequestNodeViewModel">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Border Classes="badge"
                VerticalAlignment="Center"
                Background="{Binding Method, Converter={x:Static controls:MethodToBrushConverter.Instance}}">
          <TextBlock Text="{Binding MethodBadge}"
                     Foreground="#FF15150F"
                     FontSize="10"
                     FontWeight="Bold"
                     HorizontalAlignment="Center" />
        </Border>
        <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
      </StackPanel>
    </DataTemplate>
  </Window.DataTemplates>

  <Grid RowDefinitions="*,Auto">

    <Grid Grid.Row="0" ColumnDefinitions="320,Auto,*">

      <!-- Left sidebar -->
      <Border Grid.Column="0" Background="{StaticResource SidebarBrush}"
              BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,Auto,*,Auto,Auto">

          <!-- Workspace bar -->
          <Grid Grid.Row="0" Margin="12,12,12,10" ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto">
            <controls:YamletLogo Grid.Row="0" Grid.RowSpan="2" Width="26" Height="26"
                                 VerticalAlignment="Center" Margin="0,0,10,0" />
            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Workspace.Name, FallbackValue='No workspace'}"
                       FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
            <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
              <Button Content="Open" Padding="10,4" Command="{Binding OpenWorkspaceCommand}" />
              <Button Content="New" Classes="accent" Padding="10,4" Command="{Binding NewWorkspaceCommand}" />
            </StackPanel>
          </Grid>

          <!-- COLLECTIONS section header -->
          <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="6,2,8,0">
            <Button Classes="section" Command="{Binding ToggleCollectionsCommand}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <PathIcon Width="12" Height="12" Foreground="{DynamicResource TextMutedBrush}"
                          Data="{Binding CollectionsExpanded, Converter={x:Static controls:ChevronConverter.Instance}}" />
                <TextBlock Classes="heading" Text="COLLECTIONS" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="0" VerticalAlignment="Center">
              <Button Classes="ghost" Padding="6" Command="{Binding NewCollectionCommand}" ToolTip.Tip="New collection">
                <PathIcon Data="{StaticResource IconCollections}" Width="15" Height="15" />
              </Button>
              <Button Classes="ghost" Padding="6" Command="{Binding NewFolderCommand}" ToolTip.Tip="New folder">
                <PathIcon Data="{StaticResource IconFolder}" Width="15" Height="15" />
              </Button>
              <Button Classes="ghost" Padding="6" Command="{Binding NewRequestCommand}" ToolTip.Tip="New request">
                <PathIcon Data="{StaticResource IconRequest}" Width="15" Height="15" />
              </Button>
            </StackPanel>
          </Grid>

          <!-- COLLECTIONS content -->
          <Panel Grid.Row="2" Margin="6,2,6,6" IsVisible="{Binding CollectionsExpanded}">
            <TextBlock Classes="muted" Margin="10,6" TextWrapping="Wrap" FontSize="12"
                       IsVisible="{Binding !HasWorkspace}"
                       Text="No workspace open. Use New to create a Yamlet workspace, or Open to load an existing one." />
            <TreeView ItemsSource="{Binding CollectionNodes}"
                      SelectedItem="{Binding SelectedNode}"
                      IsVisible="{Binding HasWorkspace}"
                      Background="Transparent" />
          </Panel>

          <!-- ENVIRONMENTS section header -->
          <Grid Grid.Row="3" ColumnDefinitions="*,Auto" Margin="6,0,8,0"
                Background="{StaticResource SidebarBrush}">
            <Button Classes="section" Command="{Binding ToggleEnvironmentsCommand}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <PathIcon Width="12" Height="12" Foreground="{DynamicResource TextMutedBrush}"
                          Data="{Binding EnvironmentsExpanded, Converter={x:Static controls:ChevronConverter.Instance}}" />
                <TextBlock Classes="heading" Text="ENVIRONMENTS" VerticalAlignment="Center" />
              </StackPanel>
            </Button>
          </Grid>

          <!-- ENVIRONMENTS content -->
          <Border Grid.Row="4" Margin="6,2,6,8" MaxHeight="220"
                  IsVisible="{Binding EnvironmentsExpanded}">
            <Panel>
              <TextBlock Classes="muted" Margin="10,6" FontSize="12"
                         IsVisible="{Binding !HasWorkspace}"
                         Text="Environments appear here once a workspace is open." />
              <ListBox ItemsSource="{Binding Environments}"
                       SelectedItem="{Binding SelectedEnvironment}"
                       IsVisible="{Binding HasWorkspace}"
                       Background="Transparent">
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="models:YamletEnvironment">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <PathIcon Data="{StaticResource IconEnvironment}" Width="14" Height="14"
                                Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                    </StackPanel>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>
            </Panel>
          </Border>
        </Grid>
      </Border>

      <GridSplitter Grid.Column="1" Width="1" Background="{StaticResource BorderBrush}"
                    ResizeDirection="Columns" />

      <!-- Main request/response area -->
      <Panel Grid.Column="2" Background="{StaticResource BackgroundBrush}">
        <ContentControl Content="{Binding MainContent}"
                        IsVisible="{Binding MainContent, Converter={x:Static ObjectConverters.IsNotNull}}" />
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="10"
                    IsVisible="{Binding MainContent, Converter={x:Static ObjectConverters.IsNull}}">
          <controls:YamletLogo Width="56" Height="56" HorizontalAlignment="Center" />
          <TextBlock Classes="muted" HorizontalAlignment="Center"
                     Text="Select a request, or create one to get started." />
        </StackPanel>
      </Panel>
    </Grid>

    <!-- Status bar -->
    <Border Grid.Row="1" Background="{StaticResource RailBrush}"
            BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0"
            Padding="12,5">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" FontSize="12" Classes="muted"
                   VerticalAlignment="Center" Text="{Binding StatusMessage}" />
        <TextBlock Grid.Column="1" FontSize="12" Classes="muted"
                   VerticalAlignment="Center"
                   Text="{Binding SelectedEnvironment.Name, FallbackValue='No environment'}" />
      </Grid>
    </Border>
  </Grid>

</Window>

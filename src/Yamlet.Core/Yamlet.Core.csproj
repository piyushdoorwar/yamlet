<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <!-- Namespaces are kept as Yamlet.App.* so the UI assembly's usings are unchanged. -->
    <RootNamespace>Yamlet.App</RootNamespace>
    <AssemblyName>Yamlet.Core</AssemblyName>
    <Version>0.0.0-dev</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jint" Version="4.9.2" />
    <PackageReference Include="YamlDotNet" Version="18.0.0" />
  </ItemGroup>

</Project>

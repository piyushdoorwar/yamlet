{
  "manifest_version": 3,
  "name": "Yamlet Interceptor",
  "homepage_url": "https://yamlet.piyushdoorwar.com/",
  "description": "Sync cookies from sites you approve into your local Yamlet workspace.",
  "version": "0.2.0",
  "permissions": ["activeTab", "alarms", "cookies", "storage"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["http://localhost/*", "http://127.0.0.1/*"], "js": ["bridge.js"], "run_at": "document_idle" }],
  "action": { "default_title": "Yamlet Interceptor", "default_popup": "popup.html" },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Yamlet.Cli</RootNamespace>
    <AssemblyName>yamlet</AssemblyName>

    <!-- dotnet global tool packaging -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>yamlet</ToolCommandName>
    <PackageId>Yamlet.Cli</PackageId>
    <!-- Local-dev default; CI overrides with -p:Version. -->
    <Version>0.0.0-dev</Version>
    <Authors>Piyush Doorwar</Authors>
    <Description>Yamlet CLI — run Yamlet API collections headlessly (e.g. in CI). Loads a workspace, sends every request in order, evaluates pm.test assertions, and exits non-zero on failure.</Description>
    <PackageTags>yamlet;api;http;testing;ci;cli;dotnet-tool</PackageTags>
    <PackageProjectUrl>https://github.com/piyushdoorwar/yamlet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/piyushdoorwar/yamlet.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/Yamlet.Core/Yamlet.Core.csproj" />
  </ItemGroup>

</Project>
